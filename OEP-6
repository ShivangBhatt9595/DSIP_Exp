import cv2
import numpy as np
import matplotlib.pyplot as plt
import os
# 1. Load the images
image_files = [
    r"E:\Marwadi\B.Tech\SEM 5\DSIP\OEP 6\image1.png",
    r"E:\Marwadi\B.Tech\SEM 5\DSIP\OEP 6\image2.png",
    r"E:\Marwadi\B.Tech\SEM 5\DSIP\OEP 6\image3.png"
]
# 2. Define the structuring element
kernel = cv2.getStructuringElement(
    cv2.MORPH_ELLIPSE, (3, 3)
)
# 3. Process each image
for index, file in enumerate(image_files):
    image = cv2.imread(file, cv2.IMREAD_GRAYSCALE)
    if image is None:
        print("Error: Could not read", file)
        continue
    # 4. Remove small bright noise using Opening
    opening = cv2.morphologyEx(
        image, cv2.MORPH_OPEN, kernel
    )
    # 5. Fill narrow dark cracks using Closing
    closing = cv2.morphologyEx(
        opening, cv2.MORPH_CLOSE, kernel
    )
    # 6. Display original and processed images
    results = [
        ("Original Image", image),
        ("After Opening", opening),
        ("After Closing", closing)
    ]
    plt.figure(figsize=(12, 4))
    for i, (title, output) in enumerate(results):
        plt.subplot(1, 3, i + 1)
        plt.imshow(output, cmap='gray', vmin=0, vmax=255)
        plt.title(title)
        plt.axis('off')
    plt.suptitle(
        f"Image {index + 1} - Morphological Processing",
        fontsize=14
    )
    plt.tight_layout()
    plt.show()
    # 7. Save the final processed image
    output_path = os.path.join(
        os.path.dirname(file),
        f"Image_{index + 1}_Processed.png"
    )
    cv2.imwrite(output_path, closing)
    print(f"Image {index + 1} processed successfully.")
    print("Saved at:", output_path)
