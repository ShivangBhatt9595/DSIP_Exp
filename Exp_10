import cv2
import numpy as np
import matplotlib.pyplot as plt
# 1. Read image
img = cv2.imread(r"E:\Marwadi\B.Tech\SEM 5\DSIP\Lab Manual\test.jpeg", 0)
if img is None:
    print("Error: Image not found.")
else:
    # 2. Fourier Transform
    F = np.fft.fftshift(np.fft.fft2(img))
    M, N = img.shape
    # 3. Create frequency distance matrix
    u, v = np.meshgrid(
        np.arange(N) - N//2,
        np.arange(M) - M//2
    )
    D = np.sqrt(u**2 + v**2)
    # 4. Create Gaussian Low-Pass and High-Pass Filters
    D0 = 50
    LPF = np.exp(-(D**2) / (2 * D0**2))
    HPF = 1 - LPF
    # 5. Apply filters
    smooth = np.real(
        np.fft.ifft2(np.fft.ifftshift(F * LPF))
    )
    high_pass = np.real(
        np.fft.ifft2(np.fft.ifftshift(F * HPF))
    )
    # Sharpening using high-frequency details
    sharp = np.clip(
        img.astype(float) + 1.5 * high_pass,
        0, 255
    )
    # 6. Display images
    plt.figure(figsize=(12, 4))
    plt.subplot(1, 3, 1)
    plt.imshow(img, cmap='gray', vmin=0, vmax=255)
    plt.title('Original Image')
    plt.axis('off')
    plt.subplot(1, 3, 2)
    plt.imshow(smooth, cmap='gray', vmin=0, vmax=255)
    plt.title('LPF - Smoothening')
    plt.axis('off')
    plt.subplot(1, 3, 3)
    plt.imshow(sharp, cmap='gray', vmin=0, vmax=255)
    plt.title('HPF - Sharpening')
    plt.axis('off')
    plt.tight_layout()
    plt.show()
