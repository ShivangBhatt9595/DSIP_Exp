import numpy as np
import matplotlib.pyplot as plt
from scipy.io import wavfile
# Load audio files
rate1, song = wavfile.read(r"E:\Marwadi\B.Tech\SEM 5\DSIP\Open Ended Question\Only_Mine_Song.wav")
rate2, karaoke = wavfile.read(r"E:\Marwadi\B.Tech\SEM 5\DSIP\Open Ended Question\Only_Mine_Karaoke.wav")
rate3, different = wavfile.read(r"E:\Marwadi\B.Tech\SEM 5\DSIP\Open Ended Question\audio.wav")
# Convert stereo to mono
if len(song.shape) == 2:
    song = song.mean(axis=1)
if len(karaoke.shape) == 2:
    karaoke = karaoke.mean(axis=1)
if len(different.shape) == 2:
    different = different.mean(axis=1)
# Make all signals same length
min_len = min(len(song), len(karaoke), len(different))
song = song[:min_len]
karaoke = karaoke[:min_len]
different = different[:min_len]
# Correlation
corr_song_karaoke = np.corrcoef(song, karaoke)[0,1]
corr_song_different = np.corrcoef(song, different)[0,1]
corr_karaoke_different = np.corrcoef(karaoke, different)[0,1]
# Print results
print("Original vs Karaoke :", corr_song_karaoke)
print("Original vs Different :", corr_song_different)
print("Karaoke vs Different :", corr_karaoke_different)
# Plot graphs
plt.figure(figsize=(12,8))
plt.subplot(3,1,1)
plt.plot(song)
plt.title("Original Song")
plt.subplot(3,1,2)
plt.plot(karaoke)
plt.title("Karaoke Version")
plt.subplot(3,1,3)
plt.plot(different)
plt.title("Different Song")
plt.tight_layout()
plt.show()
