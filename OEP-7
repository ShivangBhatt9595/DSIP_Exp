# APPLY SUITABLE TRANSFORMATIONS

# Image 1 - Contrast Stretching
enhanced1 = contrast_stretching(images[0])

# Image 2 - Histogram Equalization
enhanced2 = cv2.equalizeHist(images[1])

# Image 3 - Gamma Correction
enhanced3 = gamma_correction(images[2], 0.8)

# Image 4 - Log Transformation
# Mild Gaussian Blur used as preprocessing
enhanced4 = log_transformation(images[3])

# Image 5 - Contrast Stretching
enhanced5 = contrast_stretching(images[4])

# STORE RESULTS

results = [
    ("Image 1 - Contrast Stretching", images[0], enhanced1),
    ("Image 2 - Histogram Equalization", images[1], enhanced2),
    ("Image 3 - Gamma Correction", images[2], enhanced3),
    ("Image 4 - Log Transformation", images[3], enhanced4),
    ("Image 5 - Contrast Stretching", images[4], enhanced5)
]

# DISPLAY ORIGINAL AND ENHANCED IMAGES

for title, original, enhanced in results:
    plt.figure(figsize=(10, 5))
