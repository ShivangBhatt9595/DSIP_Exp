import cv2
import numpy as np
import matplotlib.pyplot as plt
# 1. Load the binary image
image = cv2.imread(
    r"E:\Marwadi\B.Tech\SEM 5\DSIP\Lab Manual\test.jpeg", 0
)
if image is None:
    print("Error: Image not found. Check the image path.")
else:
    # 2. Convert image into binary format
    _, image = cv2.threshold(
        image, 127, 255, cv2.THRESH_BINARY
    )
    # 3. Define the structuring element
    pattern = np.array([
        [-1,  1, -1],
        [ 1,  1,  1],
        [-1,  1, -1]
    ], dtype=np.int8)
    # 4. Apply Hit or Miss Transformation
    result = cv2.morphologyEx(
        image, cv2.MORPH_HITMISS, pattern
    )
    # 5. Display original image and result
    plt.figure(figsize=(10, 4))
    plt.subplot(1, 2, 1)
    plt.imshow(image, cmap='gray')
    plt.title("Original Binary Image")
    plt.axis('off')
    plt.subplot(1, 2, 2)
    plt.imshow(result, cmap='gray')
    plt.title("Hit or Miss Result")
    plt.axis('off')
    plt.tight_layout()
    plt.show()
