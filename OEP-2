import numpy as np
import matplotlib.pyplot as plt
from scipy.io import wavfile
from scipy.signal import convolve

# Load original song
rate, song = wavfile.read(r"E:\Marwadi\B.Tech\SEM 5\DSIP\Open Ended Question\audio.wav")

# Convert stereo to mono
if len(song.shape) == 2:
    song = song.mean(axis=1)

# Different impulse responses
impulse_responses = {
    "Room": np.array([1, 0.5, 0.2]),
    "Hall": np.array([1, 0.7, 0.5, 0.3]),
    "Tunnel": np.array([1, 0.9, 0.8, 0.7, 0.5])
}

for name, ir in impulse_responses.items():

    # Convolution
    convolved = convolve(song, ir, mode="same")

    # Simple inverse filtering
    recovered = convolved / np.max(np.abs(ir))

    # Save output
    wavfile.write(f"{name}_Recovered.wav", rate,
                  recovered.astype(np.int16))

    plt.figure(figsize=(10,6))

    plt.subplot(2,1,1)
    plt.plot(song)
    plt.title("Original Audio")

    plt.subplot(2,1,2)
    plt.plot(recovered)
    plt.title(name + " Recovered Audio")

    plt.tight_layout()
    plt.show()
